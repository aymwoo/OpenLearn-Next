[Unit]
Description=OpenLearn Next worker process (user)
After=default.target

[Service]
Type=exec
EnvironmentFile=%h/.config/openlearn/openlearn.env
ExecStart=/usr/bin/env bash -lc 'cd "$OPENLEARN_CURRENT_ROOT" && pnpm worker:start'
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s

[Install]
WantedBy=default.target
