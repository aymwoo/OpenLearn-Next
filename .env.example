# OpenLearn Next — single-school pilot baseline
NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# Required app secrets (replace before deploy)
AUTH_SECRET=replace-with-auth-secret
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-server-actions-encryption-key

# SQLite durable truth
DB_FILE_NAME=file:local.db

# BullMQ worker posture — blocking dependency when enabled
ASYNC_TASKS_ENABLED=true
BULLMQ_REDIS_URL=redis://127.0.0.1:6379
BULLMQ_PREFIX=openlearn:async-tasks

# Classroom fanout posture — optional capability, non-blocking when absent
REDIS_FANOUT_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# AI provider — OpenAI-compatible endpoint (server-only, never NEXT_PUBLIC_)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_NAME=openai-compatible
# AI rate limit (optional overrides; fixed-window seconds + max count)
AI_RL_TEACHER_WINDOW_SEC=60
AI_RL_TEACHER_MAX=20
AI_RL_GLOBAL_WINDOW_SEC=60
AI_RL_GLOBAL_MAX=200
# AI rate-limit Redis (defaults to BULLMQ_REDIS_URL / REDIS_URL when unset)
AI_REDIS_URL=

# Instance identity
RUNTIME_INSTANCE_ID=runtime-1
WORKER_INSTANCE_ID=worker-1

# Deploy / release / restore contract
OPENLEARN_DEPLOY_ENV=pilot-single-school
OPENLEARN_SHARED_ROOT=./shared
OPENLEARN_CURRENT_ROOT=./current
OPENLEARN_RUNTIME_ASSETS_ROOT=./runtime-assets
OPENLEARN_RELEASE_MANIFESTS_DIR=./ops/releases/manifests
OPENLEARN_HEALTHCHECK_BASE_URL=http://127.0.0.1:3000
